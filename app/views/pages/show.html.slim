- model_class = Page
.page-header
  .row.mb-3
    .col-md-12
      = label_tag :post_uri, t('label.link.post_uri'), class: 'form-label'
      = text_field_tag('post_uri', @page.post_url, class: 'form-control', onclick: 'this.select();')

- if @page.posts.empty?
  p = t('.not_found')
- else
  h3 = t('.title', request_id: @page.request_id, default: model_class.model_name.human.titleize)
  - @page.posts.each do |post|
    .row(style="background-color: #F5F5F5; margin-bottom: 40px;")
      .col-12
        h4 #{post.http_method} /#{@page.request_id}
        | #{l(post.created_at, format: :long)}
        h5 Request Headers
        table.table.table-striped.table-bordered.table-sm
          thead
            tr
              th Name
              th Value
          tbody
            - header_hash(post).each do |k, v|
              tr
                td = k
                td = v
        h5 Request Parameters
        table.table.table-striped.table-bordered.table-sm
          thead
            tr
              th Name
              th Value
          tbody
            - param_hash(post).each do |k, v|
              tr
                td = k
                td = v
        h5 RAW Post
        pre
          = raw post.raw_post
  hr
